{
  "name": "varroa-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "generate:fixtures": "python3 ../scripts/generate_fixtures.py --out web/src/model/__fixtures__/golden.json"
  },
  "dependencies": {
    "apexcharts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-apexcharts": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
